<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F0FE"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="① 填配置地址→「加载」，或「导入」选本地文件   ② 选测活深度→「开始测活」   ③ 点某站点=单测它，长按=详情，长按「诊断」=换 UA"
        android:textColor="#1A73E8"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etConfig"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:hint="配置地址（http://… 支持 2423 加密）"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:textColor="#212121"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="加载"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnImport"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="导入"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="0.8"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="清空"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测活深度"
            android:textColor="#333333"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spDepth"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.2"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="开始测活"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="停止"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExport"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="导出"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDiag"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="诊断"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="就绪 · 加载配置后点「开始测活」"
        android:textColor="#333333"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>
