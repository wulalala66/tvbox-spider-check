<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hint"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="① 填配置地址 →「加载」，或「导入」本地配置文件\n② 选测活深度 →「开始测活」（只测勾选的站点）\n③ 点站点=单测它，长按=看详情；测完自动按「可用/失败/未测」分组，「历史」按接口分别留档"
        android:textColor="#0B57D0"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etConfig"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="配置地址（http://… 支持 2423 加密）"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="#1F1F1F"
        android:textColorHint="#9AA0A6"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="加载"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnImport"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="导入"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnClear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:layout_weight="0.85"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="清空"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnHistory"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:layout_weight="0.95"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="历史"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测活深度"
            android:textColor="#5F6368"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spDepth"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingStart="14dp"
            android:paddingEnd="40dp"
            android:popupBackground="@drawable/bg_menu"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="全不选"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSelUntested"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="只选未测/失败"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="已选 0/0"
            android:textColor="#5F6368"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 结果分类：用 TextView 而不是 Button —— Material 主题会给 Button 的 background 加
         backgroundTint（主题紫色），把自定义圆角 drawable 整个染成紫底、看不出选中态。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="全部 0"
            android:textColor="@drawable/chip_text_all"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFAlive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="可用 0"
            android:textColor="@drawable/chip_text_alive"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFDead"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="失败 0"
            android:textColor="@drawable/chip_text_dead"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFUntested"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="未测 0"
            android:textColor="@drawable/chip_text_un"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="开始测活"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="停止"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnExport"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="导出"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDiag"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="诊断"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="就绪 · 加载配置后点「开始测活」"
        android:textColor="#3C4043"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="还没有结果\n填配置地址点「加载」，或点「导入」选本地配置文件"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
